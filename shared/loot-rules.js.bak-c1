    DEATH_ITEM_DROP: 0.03,      // 3% шанс дропа предмета
    DEATH_EQUIP_DROP: 0.005,    // 0.5% шанс дропа экипировки
    
    // Боссы
    BOSS_DROP_MULT: 5.0,
