// SHARED / CLASS-SYSTEM.JS
// Раса, пол, базовые классы и дерево профессий (Lineage 2 C1 / Classic, Human).
// Стимпанк-средневековье техноген. Без магии и магических слов.
// Оператор = Human Fighter · Инженер = Human Mystic (схемы / давление / пар).
// C.Atk / C.Def = сила и сопротивление схем (аналог M.Atk / M.Def).
// Сервер = авторитет; клиент = UI / предсказание.
(function (root, factory) {
  var api = factory();
  if (typeof module !== 'undefined' && module.exports) module.exports = api;
  else root.CLASS_SYSTEM = api;
})(typeof window !== 'undefined' ? window : globalThis, function () {
  'use strict';

  // ─── Расы (пока только люди, как Talking Island start) ───
  var RACES = {
    human: {
      id: 'human',
      name: 'Человек',
      nameEn: 'Human',
      description: 'Единственная доступная раса. Универсальные операторы Острова Стали.',
      genders: ['male', 'female'],
      baseClasses: ['operator', 'engineer']
    }
  };

  var GENDERS = {
    male:   { id: 'male',   name: 'Мужской', nameEn: 'Male',   short: 'М' },
    female: { id: 'female', name: 'Женский', nameEn: 'Female', short: 'Ж' }
  };

  // operator ≈ Fighter · engineer ≈ «Mystic» (тех-линия схем)
  var BASE_CLASS_IDS = ['operator', 'engineer'];

  /**
